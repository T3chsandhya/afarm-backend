# AFARM — production on AWS. Copy to `.env` on the server (never commit `.env`).

APP_NAME=AFARM
ENVIRONMENT=production
API_V1_PREFIX=/api/v1

# Storefront URL (browser)
FRONTEND_URL=https://afarm.khulega.online
API_PUBLIC_URL=https://api.afarm.khulega.online/api/v1
# Comma-separated extra origins if you use a CDN or preview domain
CORS_ORIGINS=

# Dedicated PostgreSQL database on the same EC2 (does not touch other sites' DBs)
DATABASE_URL=postgresql+asyncpg://afarm_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/afarm

JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

OTP_EXPIRE_MINUTES=10
OTP_LENGTH=4
OTP_DEBUG=false

# Login OTP — Exotel (India DLT). Sender ID: SDHYTE
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_API_HOST=api.exotel.com
EXOTEL_SMS_SENDER=SDHYTE
EXOTEL_DLT_ENTITY_ID=
EXOTEL_DLT_TEMPLATE_ID=
EXOTEL_SMS_TYPE=transactional
# Must match approved DLT text exactly — only {name} and {otp} change
EXOTEL_OTP_BODY_TEMPLATE=Hi {name}, your OTP is {otp} for Khulega Online by Sandhya Technology Solutions and Operations. It is valid for 10 minutes. Please do not share this OTP with anyone.

# Order SMS (optional; leave empty to skip)
RENFLAIR_API_KEY=

ADMIN_EMAIL=contact@afarm.in
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password
BRAND_NAME=AFARM
ADMIN_NOTIFY_PHONE=9876543210
ADMIN_NOTIFY_EMAIL=contact@afarm.in

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PAYU_KEY=
PAYU_SALT=
PAYU_MODE=live

# Media: s3 (recommended prod) | local | bunny
STORAGE_BACKEND=s3
UPLOAD_DIR=uploads
IMAGE_UPLOAD_WEBP_QUALITY=82
IMAGE_UPLOAD_MAX_EDGE=1920

# S3 + CloudFront — see deploy/aws/S3-CLOUDFRONT.md
AWS_S3_BUCKET=afarm-media-prod
AWS_S3_REGION=ap-south-1
AWS_S3_PREFIX=
AWS_CLOUDFRONT_URL=https://dxxxxxxxxxxxxx.cloudfront.net
# Leave empty on EC2 if the instance IAM role has s3:PutObject on the bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_REGION=sg
BUNNY_CDN_URL=

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_COURIER_ID=
SHIPROCKET_AUTO_PUSH=false
SHIPROCKET_AUTO_AWB=false
SHIPROCKET_DEFAULT_LENGTH=10
SHIPROCKET_DEFAULT_BREADTH=10
SHIPROCKET_DEFAULT_HEIGHT=10

DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_SHIPPING_MODE=Surface

META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=AFARM Farmer Producer Organisation Maharashtra
GOOGLE_REVIEW_URL=